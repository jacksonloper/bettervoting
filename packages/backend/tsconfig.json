{
  "compilerOptions": {
    "allowJs": true,
    "target": "es2022",
    "rootDir": ".",
    "outDir": "./build",
    "esModuleInterop": true,
    "strictNullChecks": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "jest",
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "resolveJsonModule": true
  },
  "include": ["./src/**/*", "verifyShared.js"],
  "exclude": [
    "./src/test/**",
    "**/*.test.ts"
  ]
}
